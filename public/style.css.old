* {
  box-sizing: border-box;
}

:root {
  --green: #087443;
  --green-dark: #055c35;
  --ink: #172033;
  --muted: #64748b;
  --line: #e2e8f0;
  --surface: #ffffff;
  --background: #f4f7fb;
  --danger: #b42318;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Arial, sans-serif;
  color: var(--ink);
  background: var(--background);
}

.app-shell {
  width: min(1120px, 92%);
  margin: 0 auto;
  padding: 48px 0;
}

.auth-card {
  width: min(440px, 100%);
  margin: 48px auto;
  padding: 32px;
  border-radius: 18px;
  background: var(--surface);
  box-shadow: 0 18px 45px rgba(23, 32, 51, 0.12);
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 8px;
}

h2 {
  font-size: 20px;
}

h3 {
  margin-bottom: 10px;
  font-size: 16px;
}

.eyebrow {
  margin-bottom: 8px;
  color: var(--green);
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 1.5px;
}

.muted {
  color: var(--muted);
}

form {
  display: grid;
  gap: 10px;
}

label {
  margin-top: 6px;
  font-size: 14px;
  font-weight: bold;
}

input {
  width: 100%;
  padding: 12px;
  border: 1px solid #cbd5e1;
  border-radius: 9px;
  font: inherit;
}

input:focus {
  outline: 2px solid #86efac;
  border-color: var(--green);
}

button {
  padding: 12px 16px;
  border: 0;
  border-radius: 9px;
  background: var(--green);
  color: white;
  font: inherit;
  font-weight: bold;
  cursor: pointer;
}

button:hover {
  background: var(--green-dark);
}

.text-button {
  width: 100%;
  margin-top: 12px;
  background: transparent;
  color: var(--green);
}

.text-button:hover {
  background: #edf7f1;
}

.outline-button {
  background: transparent;
  border: 1px solid #b7d8c6;
  color: var(--green);
}

.outline-button:hover {
  background: #edf7f1;
}

.message {
  min-height: 24px;
  margin: 16px 0 0;
  color: var(--danger);
  font-weight: bold;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.balance-card {
  padding: 30px;
  border-radius: 18px;
  color: white;
  background: linear-gradient(135deg, #087443, #0ba261);
}

.balance-card p {
  margin-bottom: 10px;
  opacity: 0.85;
}

.balance-card strong {
  font-size: clamp(32px, 6vw, 48px);
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin: 18px 0;
}

.summary-grid article,
.panel {
  padding: 20px;
  border-radius: 14px;
  background: var(--surface);
  box-shadow: 0 8px 24px rgba(23, 32, 51, 0.06);
}

.summary-grid span {
  display: block;
  color: var(--muted);
  font-size: 13px;
}

.summary-grid strong {
  display: block;
  margin-top: 8px;
  color: var(--green);
  font-size: 19px;
}

.content-grid {
  display: grid;
  grid-template-columns: 380px 1fr;
  gap: 18px;
}

.panel form + form {
  margin-top: 22px;
  padding-top: 22px;
  border-top: 1px solid var(--line);
}

.panel-heading {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

#transaction-count {
  color: var(--muted);
  font-size: 14px;
}

.transaction-item {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 6px;
  padding: 16px 0;
  border-bottom: 1px solid var(--line);
}

.transaction-item strong {
  text-transform: capitalize;
}

.transaction-item span {
  grid-column: 2;
  grid-row: 1;
  color: var(--green);
  font-weight: bold;
}

.transaction-item small,
.transaction-item time {
  color: var(--muted);
}

@media (max-width: 800px) {
  .summary-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .content-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 500px) {
  .app-shell {
    width: min(94%, 1120px);
    padding: 24px 0;
  }

  .topbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .summary-grid {
    grid-template-columns: 1fr;
  }

  .auth-card,
  .panel {
    padding: 22px;
  }
}

.frozen-banner {
  margin: 0 0 18px;
  padding: 14px;
  border-radius: 10px;
  color: #842029;
  background: #f8d7da;
  font-weight: bold;
}